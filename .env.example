# Frontend (Vercel production only; public value)
VITE_TELEMETRY_API_URL=https://your-render-service.example
VITE_DEPLOY_ENV=production

# Backend (Render only; never expose through VITE_ variables)
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host/database
INGEST_TOKEN_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=https://your-production-domain.example
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
MAX_BODY_SIZE=256kb
